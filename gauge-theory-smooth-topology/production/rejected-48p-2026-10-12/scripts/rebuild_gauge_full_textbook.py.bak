def cite_keys(chapter: dict) -> set[str]:
    return {SOURCES[source] for source in chapter["sources"]}


def chapter_text(chapter: dict, previous: str | None, next_title: str | None) -> str:
    figure_lines = []
    for figure_id in chapter.get("figures", []):
        figure = next(item for item in FIGURES if item[0] == figure_id)
        figure_lines.append(
            "!" + f"[{figure[3]}]" + f"(../{figure[2]})"
            + f"{{#fig-{figure_id.replace('fig-', '')}}}"
        )
    figures = "\n\n".join(figure_lines)
    cited = ", ".join(f"@{key}" for key in sorted(cite_keys(chapter)))
    theorem_note = ""
    if chapter.get("results"):
        theorem_note = (
            "\n\n## 引用する深い結果の扱い\n\n"
            "この章で使う研究級の結果は、本文中で完全証明したとは扱わない。"
            f" 参照する文献は {cited} であり、本文では仮定、結論、どこを次に使うかを明示する。"
        )
    previous_note = "この章が出発点である。" if previous is None else f"前章では「{previous}」までを用意した。"
    next_note = "ここで本書の主線は閉じる。" if next_title is None else f"次章では「{next_title}」へ進む。"
    return f"""---
title: "{chapter['title']}"
bibliography: ../references.bib
---

<!-- contract: contracts/{chapter['slug']}.json -->

# {chapter['title']}

{previous_note} この章の問いは「{chapter['question']}」である。

{chapter['story']}

{figures}

## 手で追う計算

{chapter['calculation']}

## ここで固定する言葉

{chapter['definition']}

## 計算が次に運ぶもの

この章の計算で本当に残したいものは、単語ではなく、後で再利用できる手順である。まず、何を同じと見なすかを決める。次に、同じと見なす操作で変わらない量を探す。最後に、その量が次の章で新しい方程式や不変量の候補になるかを確認する。この三段階を忘れると、定義を並べただけで、なぜその定義が必要だったのかが見えなくなる。

この章で導入した記号は、後で別の記号に置き換えて使うことがある。たとえば有限次元の核・像・余核の話は、ASD変形複体では無限次元の切断空間へ移る。円周やトーラスで確認した境界の計算は、4次元多様体の2次元サイクルの交点へ移る。接続の局所式は、SW方程式では行列式線束の接続へ移る。読者は、対象が変わっても「何が同じ役割を担っているか」を追えばよい。

逆に、ここで証明していないことも明示しておく。本文中で研究級定理を引用する章では、定理の仮定と結論だけを使い、その証明の深い部分は本書の前提には含めない。引用定理を使う箇所では、本文内で検算した部分と、文献に委ねた部分を分ける。

