def write_contract(chapter: dict, index: int) -> None:
    filename = f"{chapter['slug']}.json"
    contract = {
        "chapter_id": chapter["id"],
        "source": f"chapters/{chapter['slug']}.qmd",
        "central_question": chapter["question"],
        "reader_starting_state": "線形代数・微積分・基礎的な微分方程式だけを仮定する。",
        "prerequisites": [] if index == 0 else CHAPTERS[index - 1]["concepts"][:1],
        "new_concepts": chapter["concepts"],
        "main_derivations": ["本文の手計算節と演習で確認する。", chapter["calculation"][:80]],
        "results": chapter.get("results", []),
        "proof_depth": "D" if chapter.get("black_boxes") else ("C" if chapter.get("results") else "A"),
        "black_boxes": chapter.get("black_boxes", []),
        "rigor_statuses": ["definition", "lemma"] + (["black_box_theorem"] if chapter.get("black_boxes") else []),
        "reader_stop_points": [
            {"question": chapter["question"], "resolution": "body", "location": f"chapters/{chapter['slug']}.qmd"}
        ],
        "required_bridges": [
            "前章の出口を冒頭で明示する。",
            "次章で必要になる疑問を末尾で明示する。",
        ],
        "figures": chapter.get("figures", []),
        "sources": chapter["sources"],
        "previous_connection": "前章の主計算をこの章の入口に接続する。" if index else "導入章。",
        "next_question": "次章でこの章の道具を使う。" if index + 1 < len(CHAPTERS) else "総合章で閉じる。",
        "unresolved_stop_points": [],
    }
    (CONTRACTS_DIR / filename).write_text(json.dumps(contract, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def write_index() -> None:
    parts = []
    for part_id, part_title in PARTS.items():
        lines = [f"- **Part {part_id}　{part_title}**"]
        for chapter in CHAPTERS:
            if chapter["part"] == part_id:
                path = f"chapters/{chapter['slug']}.qmd"
                lines.append(f"  - " + f"[{chapter['title']}]" + f"({path})")
        parts.append("\n".join(lines))
    text = f"""---
title: "4次元ゲージ理論と滑らかな位相"
subtitle: "Donaldson理論からSeiberg-Witten理論へ"
description: "線形代数と微積分から出発し、交点形式、接続、ASD方程式、Donaldson理論、Seiberg-Witten理論、随伴不等式までを手で追う教科書"
sidebar: gauge-theory-smooth-topology
format:
  html:
    toc: true
---

# この本の問い {{.unnumbered}}

楕円型ゲージ方程式の解空間は、なぜ4次元多様体の滑らかな構造を検出できるのか。

本書は旧95ページ版の章順を保持しない。円周・トーラス・回転基底・有限次元方程式から始め、交点形式、接続、Hodge分解、ASDモジュライ空間、Donaldson不変量、Spin^c構造、Seiberg-Witten理論、Taubesの定理、随伴不等式へ進む。深い定理は完全証明を装わず、仮定・結論・証明の骨格・本文で使う帰結を分けて記録する。

