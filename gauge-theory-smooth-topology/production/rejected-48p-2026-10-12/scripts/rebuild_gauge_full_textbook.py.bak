"""Rebuild the gauge-theory textbook from a fresh chapter plan.

This script is intentionally one-shot: it preserves the old 95-page sources in
production/legacy-95p-sources, then writes a new 22-chapter manuscript, chapter
contracts, manifest, index, sidebar entries, and production notes.
"""

from __future__ import annotations

import json
import re
import shutil
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
