def write_quarto_sidebar() -> None:
    path = ROOT / "_quarto.yml"
    text = path.read_text(encoding="utf-8")
    lines = [
        "  - id: gauge-theory-smooth-topology",
        '    title: "4次元ゲージ理論と滑らかな位相"',
        "    style: docked",
        "    collapse-level: 1",
        "    contents:",
        "      - gauge-theory-smooth-topology/index.qmd",
    ]
    for part_id, part_title in PARTS.items():
        lines.append(f'      - text: "Part {part_id}　{part_title}"')
        lines.append("        contents:")
        for chapter in CHAPTERS:
            if chapter["part"] == part_id:
                lines.append(f"          - gauge-theory-smooth-topology/chapters/{chapter['slug']}.qmd")
    lines.extend(
        [
            '      - text: "付録"',
            "        contents:",
            "          - gauge-theory-smooth-topology/chapters/appendix-analysis.qmd",
            "          - gauge-theory-smooth-topology/chapters/appendix-notation-exercises.qmd",
        ]
    )
    replacement = "\n".join(lines)
    pattern = r"  - id: gauge-theory-smooth-topology\n.*?(?=\n  - id: sle-critical-phenomena)"
    new_text, count = re.subn(pattern, replacement, text, flags=re.DOTALL)
    if count != 1:
        raise RuntimeError("failed to replace gauge sidebar")
    path.write_text(new_text, encoding="utf-8", newline="\n")


def write_build_script_titles() -> None:
    path = ROOT / "scripts" / "build_gauge_theory_pdf.py"
    text = path.read_text(encoding="utf-8")
    replacement = "PART_TITLES = {\n" + "\n".join(
        f'    "{key}": "Part {key}　{value}",' for key, value in PARTS.items()
    ) + "\n}"
    new_text = re.sub(r"PART_TITLES = \{.*?\n\}", replacement, text, flags=re.DOTALL)
    path.write_text(new_text, encoding="utf-8", newline="\n")


def write_production_notes() -> None:
    curriculum_lines = [
        "# Curriculum from scratch",
        "",
        "作成日: 2026-10-11",
        "",
        "旧18章・95ページ構成を保持せず、22章へ再編した。主線は、手計算できる位相的量から交点形式を作り、束と接続を導入し、ASDモジュライ空間の解析を経てDonaldson理論へ進み、Spin^c構造とSeiberg-Witten理論から幾何への制約へ戻る流れである。",
        "",
    ]
    for part_id, title in PARTS.items():
        curriculum_lines.append(f"## Part {part_id}　{title}\n")
        for chapter in CHAPTERS:
            if chapter["part"] == part_id:
                curriculum_lines.append(f"- {chapter['id']}: {chapter['title']} — {chapter['question']}")
        curriculum_lines.append("")
    (PRODUCTION / "curriculum-from-scratch.md").write_text("\n".join(curriculum_lines), encoding="utf-8", newline="\n")

    dependency = ["# Reader dependency map", "", "作成日: 2026-10-11", "", "```text"]
    for chapter in CHAPTERS:
        dependency.append(f"{chapter['id']} {chapter['title']} -> {chapter['question']}")
    dependency.extend(["```", "", "Reader Stop-Pointは全章契約でbody解消とし、未解決項目をvalidatorで拒否する。"])
    (PRODUCTION / "reader-dependency-map.md").write_text("\n".join(dependency), encoding="utf-8", newline="\n")

    blueprints = ["# Chapter blueprints", "", "作成日: 2026-10-11", "", "| Chapter | First calculation | Output |", "|---|---|---|"]
    for chapter in CHAPTERS:
        blueprints.append(f"| {chapter['id']} {chapter['title']} | {chapter['calculation'][:45]}... | {chapter['pitfall'][:45]}... |")
    (PRODUCTION / "chapter-blueprints.md").write_text("\n".join(blueprints), encoding="utf-8", newline="\n")

    (PRODUCTION / "source-reuse-manifest.md").write_text(
        """# Source reuse manifest

作成日: 2026-10-11

旧95ページ版のQMD、契約、manifest、indexは `production/legacy-95p-sources/` に保存した。旧本文は正解データとして使わず、回帰防止と内容欠落確認の資料としてのみ扱う。図版生成スクリプト、PDF生成スクリプト、Quartoサイト基盤、参考文献BibTeXは再利用する。本文QMDと章契約は22章構成で新規作成した。
""",
        encoding="utf-8",
        newline="\n",
    )
    (PRODUCTION / "old-to-new-coverage-map.md").write_text(
        """# Old-to-new coverage map

作成日: 2026-10-11

旧版で不足した橋は、次の新章へ移した。

- ホモロジーから交点形式: 第2章から第4章。
- Freedman/Donaldsonの論理分離: 第5章、第16章。
- 接続・曲率・Hodge分解・ASD: 第6章から第9章。
- 楕円性・Fredholm・Kuranishi: 第10章から第13章。
- コンパクト化とDonaldson不変量: 第14章、第15章。
- Fintushel-Stern結び目手術: 第16章。
- スピノル、Spin^c、SW方程式: 第17章から第20章。
- Taubesと随伴不等式: 第21章、第22章。
""",
        encoding="utf-8",
        newline="\n",
    )
    (PRODUCTION / "issue-register.md").write_text(
        """# Issue register

作成日: 2026-10-11

| ID | Priority | Issue | Status |
|---|---|---|---|
| P0-01 | P0 | 旧18章・95ページ構成の温存 | Closed: 22章新稿へ再編 |
| P0-02 | P0 | Fintushel-Stern貼り合わせの誤説明 | Closed: 第16章で優先ロンジチュード対応を明示 |
| P1-01 | P1 | 交点形式までの橋不足 | Closed: 第2章から第4章へ連続計算を配置 |
| P1-02 | P1 | 楕円性・Fredholm性の飛躍 | Closed: 第12章と付録Aへ配置 |
| P1-03 | P1 | Spin^c/SWの型と係数の曖昧さ | Closed: 第18章、第19章で規約を固定 |
| P2-01 | P2 | 全ページの目視確認 | Open until final render QA |
""",
        encoding="utf-8",
        newline="\n",
    )


def preserve_legacy_without_renderable_sources() -> None:
    """Keep old sources, but prevent site validation from treating them as live QMD."""
    if not LEGACY.exists():
        return
    for path in list(LEGACY.rglob("*.qmd")):
        path.rename(path.with_suffix(path.suffix + ".bak"))


def main() -> None:
    LEGACY.mkdir(parents=True, exist_ok=True)
    if not (LEGACY / "chapters").exists() and CHAPTERS_DIR.exists():
        shutil.copytree(CHAPTERS_DIR, LEGACY / "chapters")
    if not (LEGACY / "contracts").exists() and CONTRACTS_DIR.exists():
        shutil.copytree(CONTRACTS_DIR, LEGACY / "contracts")
    if not (LEGACY / "manifest.round7.json").exists() and (PRODUCTION / "manifest.json").exists():
        shutil.copy2(PRODUCTION / "manifest.json", LEGACY / "manifest.round7.json")
    preserve_legacy_without_renderable_sources()

    CHAPTERS_DIR.mkdir(parents=True, exist_ok=True)
    CONTRACTS_DIR.mkdir(parents=True, exist_ok=True)
    for path in CHAPTERS_DIR.glob("*.qmd"):
        path.unlink()
    for path in CONTRACTS_DIR.glob("*.json"):
        path.unlink()

    for index, chapter in enumerate(CHAPTERS):
        source = CHAPTERS_DIR / f"{chapter['slug']}.qmd"
        previous = None if index == 0 else CHAPTERS[index - 1]["title"]
        next_title = None if index + 1 == len(CHAPTERS) else CHAPTERS[index + 1]["title"]
        source.write_text(chapter_text(chapter, previous, next_title), encoding="utf-8", newline="\n")
        write_contract(chapter, index)

    (CHAPTERS_DIR / "appendix-analysis.qmd").write_text(appendix_analysis(), encoding="utf-8", newline="\n")
    (CHAPTERS_DIR / "appendix-notation-exercises.qmd").write_text(appendix_exercises(), encoding="utf-8", newline="\n")
    write_manifest()
    write_index()
    write_quarto_sidebar()
    write_build_script_titles()
    write_production_notes()


if __name__ == "__main__":
    main()
