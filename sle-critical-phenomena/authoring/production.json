  },
  "scope": {
    "core": ["chordal SLE", "critical percolation", "LERW", "Schramm left-passage formula", "SLE4-GFF coupling"],
    "appendix": ["Brown motion", "martingale and Ito calculus", "weak convergence", "Caratheodory convergence", "Bessel process", "Hausdorff dimension", "simulation methods"],
    "advanced": ["radial and whole-plane SLE", "SLE_kappa(rho)", "locality", "restriction", "duality", "CLE", "multiple SLE"],
    "orientation_only": ["CFT dictionary", "LQG and GMC", "KPZ"],
    "excluded": ["probability-first fifty-page prelude", "full proof of Smirnov theorem", "parallel treatment of all SLE variants"]
