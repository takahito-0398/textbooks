    "C": "証明アーキテクチャ。入力、難所、核心、出力、依存先を示す。",
    "D": "結果を引用。必要性、正確な入力と出力、使用箇所、一次資料を示す。"
  },
  "status_vocabulary": ["definition", "theorem", "proposition", "lemma", "assumption", "heuristic", "physical_intuition", "conjecture", "numerical_evidence", "expected_behavior", "open_problem", "black_box_theorem"],
  "normalizations": [
    {"id": "norm-hcap", "statement": "g_t(z)=z+2t/z+O(|z|^{-3}) とし、hcap(K_t)=2t とする。", "applies_from": "ch-03"},
    {"id": "norm-brown", "statement": "標準Brown運動は E[(B_t-B_s)^2]=t-s、駆動関数は U_t=sqrt(kappa) B_t。", "applies_from": "ch-05"},
    {"id": "norm-bessel", "statement": "X_t/sqrt(kappa) のBessel次元は 1+4/kappa。", "applies_from": "ch-07"},
    {"id": "norm-dimension", "statement": "SLE traceのHausdorff次元は min(2,1+kappa/8)。", "applies_from": "ch-11"},
    {"id": "norm-cft", "statement": "c(kappa)=((3kappa-8)(6-kappa))/(2kappa)。CFT対応はheuristic registryで扱う。", "applies_from": "ch-18"}
  ],
  "domain_conventions": [
    {"id": "domain-chordal", "statement": "chordal settingは単連結領域Dと異なる二つのprime end a,bを持つ向き付き組(D;a,b)。"},
    {"id": "domain-half-plane", "statement": "等角写像で(a,b)を(0,infinity)へ送り、hydrodynamic normalizationで残る自由度を固定する。"},
    {"id": "domain-orientation", "statement": "探索経路は始点aから終点bへ向ける。左右はこの向きに対して定義する。"}
  ],
  "terminology": [
    {"term": "等角", "preferred": "等角", "note": "conformalの訳。『共形』は書名や固有の慣用句で許容する。"},
    {"term": "trace", "preferred": "trace（曲線の像）", "note": "hullと同一視しない。"},
    {"term": "hull", "preferred": "hull", "note": "曲線の像に、上半平面から切り離された成分を埋めた閉集合。"},
    {"term": "driving function", "preferred": "駆動関数", "note": "先端prime endの標準領域境界上の像。"},
    {"term": "half-plane capacity", "preferred": "半平面容量", "note": "Euclid長ではなく無限遠展開の1/z係数。"},
    {"term": "swallowing", "preferred": "飲み込み", "note": "traceが点を通過することと区別する。"},
    {"term": "universality", "preferred": "普遍性", "note": "指数、scaling function、曲線法則のどの一致かを併記する。"}
  ],
  "convergence_topologies": [
