{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbooks.yohakostudio.com/schemas/sle-chapter-contract.schema.json",
  "title": "SLE textbook chapter contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapter_id",
    "source",
    "central_question",
    "reader_starting_state",
    "mathematical_prerequisites",
    "pedagogical_prerequisites",
    "previous_connection",
    "failed_approach",
    "new_concepts",
    "derivations",
    "results",
    "proof_depth",
    "black_boxes",
    "reader_stop_points",
    "required_bridges",
    "figures",
    "sources",
    "next_question",
    "quality_budget"
  ],
  "properties": {
    "chapter_id": {"type": "string", "pattern": "^(ch|app|fixture)-[0-9]{2}$"},
    "source": {"type": "string", "pattern": "^chapters/.+\\.qmd$"},
    "central_question": {"type": "string", "minLength": 12},
    "reader_starting_state": {"type": "string", "minLength": 12},
    "mathematical_prerequisites": {"type": "array", "items": {"type": "string"}},
    "pedagogical_prerequisites": {"type": "array", "items": {"type": "string"}},
    "previous_connection": {"type": "string", "minLength": 12},
    "failed_approach": {"type": "string", "minLength": 12},
    "new_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "need", "introduced_after"],
        "properties": {
          "id": {"type": "string"},
          "need": {"type": "string", "minLength": 12},
          "introduced_after": {"type": "string", "minLength": 5}
        }
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "inputs", "assumptions", "steps_promised", "sanity_check"],
        "properties": {
          "id": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "steps_promised": {"type": "integer", "minimum": 2},
          "sanity_check": {"type": "string", "minLength": 5}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "theorem_id"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["definition", "theorem", "proposition", "lemma", "assumption", "heuristic", "physical_intuition", "conjecture", "numerical_evidence", "expected_behavior", "open_problem", "black_box_theorem"]},
          "theorem_id": {"type": ["string", "null"]}
        }
      }
    },
    "proof_depth": {"enum": ["A", "B", "C", "D"]},
    "black_boxes": {"type": "array", "items": {"type": "string"}},
    "reader_stop_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "resolution", "location"],
        "properties": {
          "question": {"type": "string", "minLength": 8},
          "resolution": {"enum": ["body", "appendix", "black_box", "unresolved"]},
          "location": {"type": "string", "minLength": 3}
        }
      }
    },
    "required_bridges": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "figures": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "next_question": {"type": "string", "minLength": 12},
    "quality_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motivations", "worked_derivations", "interpretations", "explicit_limits"],
      "properties": {
        "motivations": {"type": "integer", "minimum": 1},
        "worked_derivations": {"type": "integer", "minimum": 1},
        "interpretations": {"type": "integer", "minimum": 1},
        "explicit_limits": {"type": "integer", "minimum": 1}
      }
    }
  }
}
